{
  "name": "pei",
  "private": true,
  "description": "SaaS para elaboração e acompanhamento de Planos Educacionais Individualizados (PEI)",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @pei/shared",
    "dev:api": "npm run dev -w @pei/api",
    "dev:web": "npm run start -w @pei/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "npm run db:types -w @pei/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
