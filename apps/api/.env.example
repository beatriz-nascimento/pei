# Copie para .env e ajuste. Valores abaixo servem para o Supabase local (supabase start).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase local: postgres://postgres:postgres@127.0.0.1:54322/postgres
# Produção: string do pooler (modo transação, porta 6543) com DATABASE_SSL=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=10
DATABASE_SSL=false

SUPABASE_URL=http://127.0.0.1:54321
# Opcional: só para chaves legadas HS256. Sem ele, a API valida pelo JWKS do projeto.
# SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

WEB_URL=http://localhost:4200
# CORS_ORIGINS=http://localhost:4200,https://app.exemplo.com.br

# Gere com: openssl rand -hex 32
IP_HASH_SALT=troque-este-valor-por-um-segredo-aleatorio
