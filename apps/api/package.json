{
  "name": "@pei/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset:test": "../../supabase/tests/reset-db.sh",
    "db:types": "kysely-codegen --dialect postgres --camel-case --date-parser string --include-pattern 'public.*' --out-file src/db/types.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@pei/shared": "workspace:*",
    "docx": "^9.12.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "kysely": "^0.29.7",
    "nestjs-pino": "^5.3.1",
    "pdfmake": "^0.3.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.0",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5",
    "@nestjs/cli": "^12.0.9"
  }
}
