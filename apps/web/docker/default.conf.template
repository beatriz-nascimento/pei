# Servidor do frontend (Cloud Run). As variáveis ${...} são preenchidas na
# inicialização do container pela imagem do nginx (envsubst em /etc/nginx/templates).
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "DENY" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  # 'unsafe-inline' em style-src: o Angular Material aplica estilos inline.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${API_ORIGIN} ${SUPABASE_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  # Configuração em tempo de execução: a mesma imagem serve qualquer ambiente.
  location = /config.json {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 200 '{"apiUrl":"${API_URL}","supabaseUrl":"${SUPABASE_URL}","supabaseAnonKey":"${SUPABASE_ANON_KEY}"}';
  }

  # Arquivos com hash no nome: cache longo.
  location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA: qualquer outra rota volta para o index.html.
  location / {
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
